# RevenueOS Environment Variables Example
# Copy this file to .env and fill in your credentials

# Razorpay Test Mode Credentials (Optional - MockProvider used automatically if missing)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET_HERE
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_HERE

# Database URL (SQLite default or PostgreSQL)
DATABASE_URL=sqlite:///./revenueos.db

# Application Settings
DEBUG=true
PROJECT_NAME="Razorpay RevenueOS"
API_V1_STR="/api/v1"
